class Entrada:
    __slots__ = ("nombre", "ruta", "es_dir", "es_link", "_st", "_vis", "_clave")

    def __init__(self, de):
        self.nombre, self.ruta = de.name, de.path
        try:
            self.es_link = de.is_symlink()
        except OSError:
            self.es_link = False
        try:
            self.es_dir = de.is_dir()
        except OSError:
            self.es_dir = False
        self._st = self._vis = self._clave = None

    @property
    def st(self):
        """stat del fichero (del destino si es un enlace); se pide solo cuando hace falta."""
        if self._st is None:
            try:
                self._st = os.stat(self.ruta)
            except OSError:
                try:
                    self._st = os.lstat(self.ruta)
                except OSError:
                    self._st = False
        return self._st or None

    @property
    def visible(self):
        if self._vis is None:
            self._vis = limpia(self.nombre)
        return self._vis

    @property
    def clave(self):
        if self._clave is None:
            self._clave = sin_acentos(self.nombre.casefold())
        return self._clave

    @property
    def tam(self):
        return self.st.st_size if self.st else 0

    @property
    def mtime(self):
        return self.st.st_mtime if self.st else 0

    @property
    def roto(self):
        return self.es_link and (self.st is None or stat.S_ISLNK(self.st.st_mode))

    @property
    def exe(self):
        return not self.es_dir and self.st is not None and bool(self.st.st_mode & 0o111)


def clave_orden(orden):
    if orden == "fecha":
        return lambda e: (not e.es_dir, -e.mtime, clave_natural(e.nombre))
    if orden == "tamaño":
        return lambda e: (not e.es_dir, 0 if e.es_dir else -e.tam, clave_natural(e.nombre))
    if orden == "tipo":
        return lambda e: (not e.es_dir, "" if e.es_dir else os.path.splitext(e.nombre)[1].casefold(),
                          clave_natural(e.nombre))
    return lambda e: (not e.es_dir, clave_natural(e.nombre))


class Listado:
    """Contenido de una carpeta, ya ordenado. Nunca entra en subcarpetas."""

    def __init__(self, ruta, ocultos, orden):
        self.ruta, self.error, self.entradas = ruta, None, []
        try:
            self.mtime = os.stat(ruta).st_mtime_ns
        except OSError:
            self.mtime = None
        try:
            with os.scandir(ruta) as it:
                self.entradas = [Entrada(d) for d in it if ocultos or not d.name.startswith(".")]
        except PermissionError:
            self.error = "sin permiso"
        except OSError as e:
            self.error = e.strerror or str(e)
        self.entradas.sort(key=clave_orden(orden))
        self.indice = {e.nombre: i for i, e in enumerate(self.entradas)}


