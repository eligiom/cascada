_CONTROL = {i: "·" for i in range(32) if i != 10} | {127: "·"}
_NUM = re.compile(r"([0-9]+)")


def ancho_car(c):
    if ord(c) < 0x300:
        return 1
    if unicodedata.combining(c) or unicodedata.category(c) in ("Mn", "Me", "Cf"):
        return 0
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1


def ancho(s):
    """Columnas que ocupa s en pantalla."""
    return len(s) if s.isascii() else sum(map(ancho_car, s))


def recorta(s, w, puntos="…"):
    """s cortado a w columnas como mucho."""
    if w <= 0:
        return ""
    if ancho(s) <= w:
        return s
    tope, a, out = w - len(puntos), 0, []
    for c in s:
        a += ancho_car(c)
        if a > tope:
            break
        out.append(c)
    return "".join(out) + puntos


def recorta_nombre(nombre, w):
    """Como recorta, pero deja la extensión a la vista: «informe lar….pdf»."""
    if ancho(nombre) <= w:
        return nombre
    raiz, ext = os.path.splitext(nombre)
    if ext and raiz and ancho(ext) <= 8 and w >= ancho(ext) + 4:
        return recorta(raiz, w - ancho(ext)) + ext
    return recorta(nombre, w)


def ajusta(s, w):
    return s + " " * (w - ancho(s))


def limpia(s):
    """Nombre apto para la pantalla: sin caracteres de control ni bytes sueltos."""
    if s.isascii() and s.isprintable():
        return s
    return "".join(c if c.isprintable() else "" if unicodedata.category(c) == "Cf" else "?" for c in s)


def sin_acentos(s):
    if s.isascii():
        return s
    return "".join(c for c in unicodedata.normalize("NFD", s) if not unicodedata.combining(c))


def clave_natural(s):
    """Orden natural y sin distinguir mayúsculas ni acentos: img2 antes que img10."""
    partes = _NUM.split(sin_acentos(s.casefold()))
    return [(0, int(p), "") if i % 2 else (1, 0, p) for i, p in enumerate(partes) if p]


def humano(n):
    if n < 1024:
        return f"{n} B"
    for u in ("KB", "MB", "GB", "TB"):
        n /= 1024
        if n < 1024 or u == "TB":
            return (f"{n:.1f}" if n < 100 else f"{n:.0f}").replace(".", ",") + " " + u


def fecha(ts):
    try:
        return datetime.fromtimestamp(ts).strftime("%d/%m/%Y %H:%M")
    except (OverflowError, OSError, ValueError):
        return "?"


def cuenta(n, uno="elemento", varios="elementos"):
    return f"{n} {uno if n == 1 else varios}"


def abrevia(ruta):
    if ruta == HOME or ruta.startswith(HOME + "/"):
        return "~" + ruta[len(HOME):]
    return ruta


_duenos = {}


def dueno(uid):
    if uid not in _duenos:
        try:
            _duenos[uid] = pwd.getpwuid(uid).pw_name
        except KeyError:
            _duenos[uid] = str(uid)
    return _duenos[uid]


def corre(args, espera=3):
    """Salida de un programa auxiliar, o None si falla o tarda demasiado."""
    try:
        r = subprocess.run(args, capture_output=True, timeout=espera, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else None


