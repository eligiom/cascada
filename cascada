def sitios(favoritos=()):
    """[(etiqueta, ruta, detalle)]: carpeta personal, favoritos propios y de Nautilus, discos montados."""
    vistos, out = set(), []

    def pon(etiqueta, ruta, detalle=""):
        ruta = os.path.normpath(ruta)
        if ruta not in vistos and os.path.isdir(ruta):
            vistos.add(ruta)
            out.append((etiqueta, ruta, detalle))

    def libre(ruta):
        try:
            u = shutil.disk_usage(ruta)
            return f"{humano(u.free)} libres de {humano(u.total)}"
        except OSError:
            return ""

    pon("Carpeta personal", HOME)
    for ruta in favoritos:
        pon("★ " + limpia(os.path.basename(ruta) or "/"), ruta)
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    try:
        for lin in Path(config, "user-dirs.dirs").read_text().splitlines():
            m = re.match(r'XDG_\w+_DIR="(.*)"', lin.strip())
            if m:
                ruta = m.group(1).replace("$HOME", HOME)
                pon(os.path.basename(ruta), ruta)
    except OSError:
        pass
    for marcadores in ("gtk-3.0/bookmarks", "gtk-4.0/bookmarks"):
        try:
            for lin in Path(config, marcadores).read_text().splitlines():
                uri, _, etiqueta = lin.strip().partition(" ")
                if uri.startswith("file://"):
                    ruta = urllib.parse.unquote(uri[7:])
                    pon(etiqueta or os.path.basename(ruta), ruta)
        except OSError:
            pass
    pon("Papelera", os.path.join(HOME, ".local/share/Trash/files"))
    pon("Raíz", "/", libre("/"))
    try:
        for lin in Path("/proc/mounts").read_text().splitlines():
            disp, punto, tipo = lin.split()[:3]
            punto = punto.encode().decode("unicode_escape").encode("latin-1").decode("utf-8", "replace")
            en_red = tipo in FS_RED
            disco = disp.startswith("/dev/") and not disp.startswith("/dev/loop")
            if punto.startswith(("/boot", "/snap", "/var/snap", "/run/snapd", "/sys", "/proc")):
                continue
            if en_red or disco:
                # A un disco de red no se le pregunta el espacio: si no responde, cuelga.
                pon(os.path.basename(punto) or "/", punto, "red" if en_red else libre(punto))
    except (OSError, ValueError):
        pass
    return out


