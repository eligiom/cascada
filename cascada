class Vista:
    """Líneas listas para pintar: cada una es una lista de (texto, papel)."""
    __slots__ = ("lineas", "info")

    def __init__(self, lineas, info=""):
        self.lineas, self.info = lineas, info


def nota(texto, w=200):
    return [[]] + [[(lin, "tenue")] for lin in textwrap.wrap(f"({texto})", max(10, w - 1))]


def decodifica(datos):
    """Texto del fichero, o None si es binario."""
    if datos.startswith(b"\xef\xbb\xbf"):
        return datos[3:].decode("utf-8", "replace")
    if datos[:2] in (b"\xff\xfe", b"\xfe\xff"):
        return datos.decode("utf-16", "replace")
    cabeza = datos[:8192]
    if b"\0" in cabeza:
        return None
    try:
        return datos.decode("utf-8")
    except UnicodeDecodeError as e:
        if e.start >= len(datos) - 4:  # carácter partido por leer solo el principio
            return datos.decode("utf-8", "ignore")
    if sum(b < 9 or 13 < b < 32 for b in cabeza) > len(cabeza) // 20:
        return None
    return datos.decode("cp1252", "replace")


_papeles = {}


def papel_de(tt):
    """Papel de color para un tipo de token de pygments."""
    p = _papeles.get(tt)
    if p is None:
        from pygments.token import Comment, Generic, Keyword, Name, Number, Operator, String
        if tt in Comment:
            p = "com"
        elif tt in Keyword or tt in Operator.Word or tt in Generic.Heading or tt in Generic.Subheading:
            p = "kw"
        elif tt in String or tt in Generic.Inserted:
            p = "str"
        elif tt in Number or tt in Name.Attribute or tt in Name.Constant:
            p = "num"
        elif tt in Name.Function or tt in Name.Class or tt in Name.Decorator or tt in Name.Tag:
            p = "fn"
        elif tt in Generic.Deleted or tt in Generic.Error:
            p = "roto"
        else:
            p = "txt"
        _papeles[tt] = p
    return p


def resalta(texto, nombre):
    """(líneas coloreadas, nombre del lenguaje). Sin pygments o sin lexer, texto liso."""
    try:
        from pygments.lexers import TextLexer, get_lexer_for_filename
        lexer = get_lexer_for_filename(nombre, stripnl=False, ensurenl=False)
        if isinstance(lexer, TextLexer):
            raise ValueError
        lineas = [[]]
        for tt, val in lexer.get_tokens(texto):
            papel = papel_de(tt)
            for i, trozo in enumerate(val.split("\n")):
                if i:
                    lineas.append([])
                if trozo:
                    lineas[-1].append((trozo, papel))
        return lineas, lexer.name
    except Exception:  # ClassNotFound, o un lexer que tropieza: se enseña sin colores
        return [[(lin, "txt")] for lin in texto.split("\n")], ""


def vista_texto(texto, nombre, cortado, completa):
    texto = texto.replace("\r\n", "\n").replace("\r", "\n").expandtabs(4).translate(_CONTROL)
    texto = texto.removesuffix("\n")
    if len(texto) <= 300_000:
        lineas, lenguaje = resalta(texto, nombre)
    else:
        lineas, lenguaje = [[(lin, "txt")] for lin in texto.split("\n")], ""
    info = f"{len(lineas)}+ líneas" if cortado else cuenta(len(lineas), "línea", "líneas")
    if cortado and completa:
        lineas += [[], [("(el fichero sigue; solo se enseña el principio)", "tenue")]]
    return Vista(lineas, f"{lenguaje} · {info}" if lenguaje else info)


def volcado(datos, por_fila):
    lineas = []
    for i in range(0, len(datos), por_fila):
        fila = datos[i:i + por_fila]
        hexa = " ".join(f"{b:02X}" for b in fila)
        if por_fila == 16:
            hexa = hexa[:23] + " " + hexa[23:]
        letras = "".join(chr(b) if 32 <= b < 127 else "·" for b in fila)
        lineas.append([(f"{i:08X}  ", "hex_off"), (ajusta(hexa, por_fila * 3 + 1), "txt"), (letras, "str")])
    return lineas


def vista_binaria(ruta, datos, w, completa):
    desc = (corre(["file", "-b", ruta], 2) or "fichero binario").strip()
    lineas = [[(lin, "kw")] for lin in textwrap.wrap(desc, max(20, w - 2))] + [[]]
    lineas += volcado(datos[:262_144 if completa else 1024], 16 if w >= 78 else 8)
    return Vista(lineas, "binario")


def rgb256(r, g, b):
    """Índice de la paleta de 256 más cercano a un color."""
    def q(v):
        return 0 if v < 48 else 1 if v < 115 else (v - 35) // 40
    niveles = (0, 95, 135, 175, 215, 255)
    qr, qg, qb = q(r), q(g), q(b)
    gris = (r + g + b) // 3
    gi = 0 if gris < 8 else 23 if gris > 238 else (gris - 8) // 10
    gv = 8 + 10 * gi
    d_cubo = (r - niveles[qr]) ** 2 + (g - niveles[qg]) ** 2 + (b - niveles[qb]) ** 2
    d_gris = (r - gv) ** 2 + (g - gv) ** 2 + (b - gv) ** 2
    return 232 + gi if d_gris < d_cubo else 16 + 36 * qr + 6 * qg + qb


def vista_imagen(ruta, w, h):
    """La imagen con medios bloques (▀) y 16 colores, como en una EGA. None si no se puede."""
    try:
        from PIL import Image
        with Image.open(ruta) as im:
            tam, formato = im.size, im.format
            im.draft("RGB", (w * 2, h * 4))
            alfa = im.mode in ("RGBA", "LA", "PA") or "transparency" in im.info
            im = im.convert("RGBA" if alfa else "RGB")
            im.thumbnail((max(1, w), max(2, h * 2)))
            if alfa:
                im = Image.alpha_composite(Image.new("RGBA", im.size, (48, 48, 48, 255)), im).convert("RGB")
            # Paleta de 16 colores a medida de la imagen y, con ella, tramado como en los 90.
            im = im.quantize(palette=im.quantize(colors=16), dither=Image.Dither.FLOYDSTEINBERG)
            paleta = im.getpalette() or []
            px, (aw, ah) = im.load(), im.size
    except Exception:  # formato raro, imagen rota, sin Pillow…
        return None
    color = [rgb256(*paleta[i:i + 3]) for i in range(0, len(paleta) - 2, 3)]
    sangria = " " * ((w - aw) // 2)
    lineas = []
    for y in range(0, ah, 2):
        linea, previo, n = [(sangria, "txt")] if sangria else [], None, 0
        for x in range(aw):
            a = color[px[x, y]]
            b = color[px[x, y + 1]] if y + 1 < ah else -1
            # Un par (tinta, fondo) sirve para las dos orientaciones: ▀ y ▄.
            celda = ("▀", (a, -1)) if b < 0 else (" ", (a, a)) if a == b else \
                ("▀", (a, b)) if a < b else ("▄", (b, a))
            if celda == previo:
                n += 1
                continue
            if previo:
                linea.append((previo[0] * n, previo[1]))
            previo, n = celda, 1
        linea.append((previo[0] * n, previo[1]))
        lineas.append(linea)
    return Vista(lineas, f"{formato} {tam[0]}×{tam[1]}")


def vista_pdf(ruta, completa):
    args = ["pdftotext", "-l", "30" if completa else "2", "-nopgbrk"] + (["-layout"] if completa else [])
    salida = corre(args + [ruta, "-"], 6 if completa else 2)
    if salida is None:
        return None
    if not salida.strip():
        return Vista(nota("PDF sin texto, seguramente escaneado"), "PDF")
    return Vista([[(lin, "txt")] for lin in salida.translate(_CONTROL).rstrip("\n").split("\n")], "PDF")


def vista_archivo(ruta, nombre, completa):
    """Lo que hay dentro de un comprimido."""
    tope, filas, total = (5000 if completa else 300), [], None
    try:
        if nombre.endswith(ZIPS):
            with zipfile.ZipFile(ruta) as z:
                dentro = z.infolist()
                total = len(dentro)
                filas = [(i.file_size, i.filename) for i in dentro[:tope]]
        elif nombre.endswith(TARS):
            t0 = time.monotonic()
            with tarfile.open(ruta) as t:
                for m in t:
                    filas.append((m.size, m.name + ("/" if m.isdir() else "")))
                    if len(filas) >= tope or time.monotonic() - t0 > 1.5:
                        break
                else:
                    total = len(filas)
        else:
            salida = corre(["7z", "l", "-ba", ruta], 4)
            if salida is None:
                return None
            return Vista([[(lin, "txt")] for lin in salida.translate(_CONTROL).rstrip("\n").split("\n")],
                         "comprimido")
    except Exception:  # comprimido roto o de un formato que no es el que dice
        return None
    lineas = [[(f"{humano(tam):>9}  ", "hex_off"), (limpia(n), "dir" if n.endswith("/") else "txt")]
              for tam, n in filas]
    if total is None or total > len(filas):
        lineas.append([("        …", "tenue")])
    return Vista(lineas or nota("vacío"), cuenta(total) if total is not None else f"{len(filas)}+ elementos")


def vista_fichero(ruta, st, w, h, completa=False, con_imagen=True):
    """Lo que se enseña de un fichero: en la columna de vista previa o, con completa, en el visor."""
    nombre = os.path.basename(ruta).lower()
    ext = os.path.splitext(nombre)[1]
    try:
        if st is None or stat.S_ISLNK(st.st_mode):
            return Vista(nota("enlace roto: no existe aquello a lo que apunta", w))
        if not stat.S_ISREG(st.st_mode):
            return Vista(nota((corre(["file", "-b", ruta], 2) or "fichero especial").strip(), w))
        if st.st_size == 0:
            return Vista(nota("fichero vacío"))
        v = None
        if con_imagen and ext in IMAGENES:
            v = vista_imagen(ruta, w, h)
        elif ext == ".pdf":
            v = vista_pdf(ruta, completa)
        elif nombre.endswith(ZIPS + TARS + OTROS_ARCHIVOS):
            v = vista_archivo(ruta, nombre, completa)
        if v:
            return v
        with open(ruta, "rb") as f:
            datos = f.read(2_000_000 if completa else 48_000)
        texto = decodifica(datos)
        if texto is None:
            return vista_binaria(ruta, datos, w, completa)
        return vista_texto(texto, nombre, len(datos) < st.st_size, completa)
    except PermissionError:
        return Vista(nota("sin permiso de lectura", w))
    except OSError as e:
        return Vista(nota(e.strerror or str(e), w))
    except Exception as e:  # una vista previa nunca debe tumbar el programa
        return Vista(nota(f"no se puede previsualizar: {type(e).__name__}", w))


