class Cancelado(Exception):
    pass


def borra(ruta):
    if os.path.isdir(ruta) and not os.path.islink(ruta):
        shutil.rmtree(ruta)
    else:
        os.unlink(ruta)


def a_la_papelera(rutas):
    """Manda rutas a la papelera con gio. Devuelve el texto del error, o '' si todo fue bien."""
    if not shutil.which("gio"):
        return "no está instalado «gio»"
    error = ""
    for i in range(0, len(rutas), 200):
        try:
            r = subprocess.run(["gio", "trash", "--", *rutas[i:i + 200]], capture_output=True, text=True,
                               stdin=subprocess.DEVNULL)
        except OSError as e:
            return str(e)
        if r.returncode:
            # gio dice «gio: file:///ruta: motivo»; interesa el motivo
            error = (r.stderr.strip().splitlines() or ["error desconocido"])[-1].rpartition(": ")[2]
    return error


def nombre_libre(destino):
    """destino si no existe; si existe, «nombre (copia).ext», «nombre (copia 2).ext»…"""
    if not os.path.lexists(destino):
        return destino
    carpeta, nombre = os.path.split(destino)
    raiz, ext = os.path.splitext(nombre)
    n = 1
    while True:
        cand = os.path.join(carpeta, f"{raiz} (copia{'' if n == 1 else f' {n}'}){ext}")
        if not os.path.lexists(cand):
            return cand
        n += 1


class Tarea:
    """Copia o mueve en un hilo aparte; la interfaz solo mira sus contadores."""

    def __init__(self, pares, mover):
        self.pares, self.mover = pares, mover  # pares: (origen, destino, pisar)
        self.total = self.hecho = 0
        self.actual = ""
        self.errores, self.hechos = [], []
        self.cancelar = self.fin = False

    def error(self, ruta, e):
        self.errores.append(f"{limpia(os.path.basename(ruta))}: {getattr(e, 'strerror', None) or e}")

    def pesa(self, ruta):
        st = os.lstat(ruta)
        if not stat.S_ISDIR(st.st_mode):
            return st.st_size
        total = 0
        for raiz, _, ficheros in os.walk(ruta):
            if self.cancelar:
                raise Cancelado
            for f in ficheros:
                try:
                    total += os.lstat(os.path.join(raiz, f)).st_size
                except OSError:
                    pass
        return total

    def copia(self, origen, destino, pisar=False):
        if self.cancelar:
            raise Cancelado
        st = os.lstat(origen)
        if stat.S_ISLNK(st.st_mode):
            if pisar and os.path.lexists(destino):
                os.unlink(destino)
            os.symlink(os.readlink(origen), destino)
        elif stat.S_ISDIR(st.st_mode):
            os.mkdir(destino)
            with os.scandir(origen) as it:
                nombres = [d.name for d in it]
            for n in nombres:
                try:
                    self.copia(os.path.join(origen, n), os.path.join(destino, n))
                except OSError as e:
                    self.error(os.path.join(origen, n), e)
            self.copia_atributos(origen, destino)
        elif stat.S_ISREG(st.st_mode):
            self.actual = os.path.basename(origen)
            # "xb": si entretanto ha aparecido algo en el destino, falla en vez de pisarlo.
            with open(origen, "rb") as f, open(destino, "wb" if pisar else "xb") as g:
                try:
                    while trozo := f.read(1 << 20):
                        if self.cancelar:
                            raise Cancelado
                        g.write(trozo)
                        self.hecho += len(trozo)
                except BaseException:
                    os.unlink(destino)  # no dejar un fichero a medias
                    raise
            self.copia_atributos(origen, destino)
        else:
            raise OSError("fichero especial, no se copia")

    @staticmethod
    def copia_atributos(origen, destino):
        try:
            shutil.copystat(origen, destino, follow_symlinks=False)
        except OSError:
            pass  # p. ej. un disco FAT que no admite permisos

    def run(self):
        try:
            plan = []
            for origen, destino, pisar in self.pares:
                directo = False
                if self.mover:
                    try:
                        directo = os.lstat(origen).st_dev == os.stat(os.path.dirname(destino)).st_dev
                    except OSError:
                        pass
                if not directo:
                    self.total += self.pesa(origen)
                plan.append((origen, destino, pisar, directo))
            for origen, destino, pisar, directo in plan:
                if self.cancelar:
                    break
                self.actual = os.path.basename(origen)
                existia = os.path.lexists(destino)
                antes = len(self.errores)
                try:
                    if directo:
                        if existia and not pisar:
                            raise FileExistsError("ya existe en el destino")
                        os.replace(origen, destino)
                    else:
                        self.copia(origen, destino, pisar)
                        # Solo se quita el original si su copia ha salido entera.
                        if self.mover and len(self.errores) == antes:
                            borra(origen)
                    self.hechos.append(destino)
                except Cancelado:
                    if not existia and os.path.isdir(destino) and not os.path.islink(destino):
                        shutil.rmtree(destino, ignore_errors=True)  # copia a medias, recién creada
                    break
                except OSError as e:
                    self.error(origen, e)
        except Cancelado:
            pass
        finally:
            self.fin = True


