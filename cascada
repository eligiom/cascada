class App:
    def __init__(self, scr, ruta, sel, tema):
        self.scr = scr
        self.cwd = ruta
        self.anterior = ruta
        self.sel = {}       # carpeta → nombre bajo el cursor
        self.pos = {}       # carpeta → índice del cursor, por si el nombre desaparece
        self.top = {}       # carpeta → primera fila visible
        self.marcas = set()  # nombres marcados en la carpeta actual
        self.filtro, self.filtrando, self._filt = "", False, (None, None, [])
        self.porta = ([], False)  # portapapeles: rutas y si es para mover
        self.aviso = ""
        self.cache = {}
        self.vistas = OrderedDict()
        self.cols, self.zonas_f, self.pendiente = [], [], None
        self.clic = (0, -1, -1)
        self.libre_cache = (None, 0, "")
        self.salir = False
        self.final = None
        self.H, self.W, self.alto = 0, 0, 0
        self.fondo = self.dibuja  # lo que se pinta debajo de un diálogo

        estado = self.lee_estado()
        self.ocultos = bool(estado.get("ocultos", False))
        self.orden = estado.get("orden") if estado.get("orden") in ORDENES else "nombre"
        self.tema_nombre = tema or (estado.get("tema") if estado.get("tema") in TEMAS else "dos")
        favoritos = estado.get("favoritos")
        self.favoritos = [f for f in favoritos if isinstance(f, str)] if isinstance(favoritos, list) else []
        if sel:
            self.sel[ruta] = sel
            self.ocultos = self.ocultos or sel.startswith(".")

        curses.set_escdelay(25)
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        # Sin intervalo y sin pedir «clics»: si se deja a ncurses componerlos, entrega los eventos
        # con uno de retraso. El doble clic se detecta aquí (lee_raton).
        curses.mouseinterval(0)
        curses.mousemask(curses.BUTTON1_PRESSED | curses.BUTTON1_RELEASED | curses.BUTTON4_PRESSED | BOTON5)
        self.colores = curses.has_colors()
        self.img_ok = self.colores and curses.COLORS >= 256 and curses.COLOR_PAIRS >= 256
        self._pares, self._at, self._pimg, self._img = {}, {}, {}, None
        self.pon_tema(self.tema_nombre)

    # ── Estado guardado ──

    @staticmethod
    def lee_estado():
        try:
            estado = json.loads(ESTADO.read_text())
        except (OSError, ValueError):
            return {}
        return estado if isinstance(estado, dict) else {}

    def guarda_estado(self):
        try:
            ESTADO.parent.mkdir(parents=True, exist_ok=True)
            ESTADO.write_text(json.dumps({"tema": self.tema_nombre, "ocultos": self.ocultos,
                                          "orden": self.orden, "favoritos": self.favoritos},
                                         ensure_ascii=False, indent=1))
        except OSError:
            pass

    # ── Colores ──

    def pon_tema(self, nombre):
        self.tema_nombre, self.tema = nombre, TEMAS[nombre]
        self._pares.clear()
        self._at.clear()
        self._pimg.clear()
        self._img = None
        self.scr.bkgd(" ", self.at("base"))

    @staticmethod
    def color(i):
        """Índice de la paleta de 256 llevado a lo que tenga la terminal."""
        if curses.COLORS >= 256:
            return i
        if i >= 232:
            r = g = b = 8 + 10 * (i - 232)
        else:
            i -= 16
            r, g, b = ((0, 95, 135, 175, 215, 255)[v] for v in (i // 36, i // 6 % 6, i % 6))
        c = (r > 110) | (g > 110) << 1 | (b > 110) << 2
        return c + 8 if curses.COLORS >= 16 and max(r, g, b) > 200 else c

    def at(self, papel):
        a = self._at.get(papel)
        if a is None and not self.colores:
            # Terminal sin color: lo que lleva fondo propio va en vídeo inverso.
            inverso = papel in ("cursor", "cursor_marc", "camino", "barra", "ftxt", "dlg", "dlg_tenue", "dlg_err")
            a = self._at[papel] = curses.A_REVERSE if inverso else \
                curses.A_BOLD if len(self.tema[papel]) > 2 else 0
        if a is None:
            tinta, fondo, *extra = self.tema[papel]
            n = self._pares.get((tinta, fondo))
            if n is None:
                n = len(self._pares) + 1
                if n < ZONA_IMG:
                    curses.init_pair(n, self.color(tinta), self.color(fondo))
                    self._pares[tinta, fondo] = n
                else:
                    n = 0
            a = self._at[papel] = curses.color_pair(n) | (extra[0] if extra else 0)
        return a

    def at_img(self, tinta, fondo):
        n = self._pimg.get((tinta, fondo))
        if n is None:
            n = ZONA_IMG + len(self._pimg)
            if n > 255:
                return self.at("txt")
            curses.init_pair(n, tinta, self.tema["base"][1] if fondo < 0 else fondo)
            self._pimg[tinta, fondo] = n
        return curses.color_pair(n)

    # ── Pintar ──

    def pon(self, y, x, s, at=0, w=None):
        """Escribe s en (y, x) recortado a w columnas y a la pantalla. Nunca lanza."""
        if not (0 <= y < self.H and 0 <= x < self.W):
            return
        lim = self.W - x if w is None else min(w, self.W - x)
        if ancho(s) > lim:
            s = recorta(s, lim, "")
        try:
            self.scr.addstr(y, x, s, at)
        except (curses.error, ValueError, UnicodeError):
            pass  # la última celda de la pantalla siempre protesta

    def pinta_lineas(self, x, y, w, alto, vista, desde=0, dx=0, marca=-1):
        if self._img is not vista and any(type(p) is tuple for lin in vista.lineas[:2] for _, p in lin):
            self._pimg.clear()  # otra imagen: sus pares de color sustituyen a los de la anterior
            self._img = vista
        lineas = vista.lineas
        for f in range(min(alto, len(lineas) - desde)):
            cx, resto, salta = x, w, dx
            for txt, papel in lineas[desde + f]:
                if salta:
                    if len(txt) <= salta:
                        salta -= len(txt)
                        continue
                    txt, salta = txt[salta:], 0
                if resto <= 0:
                    break
                a = ancho(txt)
                if a > resto:
                    txt = recorta(txt, resto, "")
                    a = ancho(txt)
                at = self.at("camino") if desde + f == marca else \
                    self.at(papel) if type(papel) is str else self.at_img(*papel)
                self.pon(y + f, cx, txt, at)
                cx += a
                resto -= a

    def papel_de(self, e):
        if e.nombre.startswith("."):
            return "oculto"
        if e.es_dir:
            return "dir"
        if e.roto:
            return "roto"
        if e.es_link:
            return "link"
        return "exe" if e.exe else "fich"

    def pinta_lista(self, x, w, ents, i_sel, top, modo, error=None):
        if error or not ents:
            self.pon(3 if self.alto > 1 else 2, x + 1, recorta(f"({error or 'vacía'})", w - 2), self.at("tenue"))
            return
        con_tam = modo == "activa" and w >= 31
        for f in range(min(self.alto, len(ents) - top)):
            e = ents[top + f]
            marcada = modo == "activa" and e.nombre in self.marcas
            dcha = "▸" if e.es_dir else humano(e.tam) if con_tam and e.st else ""
            hueco = w - 2 - (ancho(dcha) + 1 if dcha else 0)
            txt = ("√" if marcada else " ") + ajusta(recorta_nombre(e.visible, hueco), hueco) \
                + (" " + dcha if dcha else "") + " "
            if top + f == i_sel:
                papel = "camino" if modo != "activa" else "cursor_marc" if marcada else "cursor"
            else:
                papel = "marcado" if marcada else self.papel_de(e)
            self.pon(2 + f, x, txt, self.at(papel), w)

    def reparto(self):
        """Carpetas que se enseñan y anchos: columnas antepasadas, activa y vista previa."""
        interior = self.W - 2
        resto = interior - max(20, interior * 36 // 100)
        cadena = [self.cwd]
        while (padre := os.path.dirname(cadena[0])) != cadena[0]:
            cadena.insert(0, padre)
        n = max(0, min(3, (resto - 30) // 20, len(cadena) - 1))
        util = resto - (n + 1)
        w_ant = min(22, (util - 30) // n) if n else 0
        w_act = min(44, util - n * w_ant)
        return cadena[-(n + 1):], w_ant, w_act, interior - (n + 1) - n * w_ant - w_act

    def dibuja(self, final=True):
        """Pinta la pantalla principal. final=False: sirve de fondo a un diálogo, que es quien refresca."""
        scr = self.scr
        self.H, self.W = H, W = scr.getmaxyx()
        scr.erase()
        self.cols, self.zonas_f, self.pendiente = [], [], None
        if H < 10 or W < 48:
            self.alto = 1
            self.pon(0, 0, recorta("Agranda la ventana (mínimo 48×10)", W), self.at("base"))
            if final:
                scr.refresh()
            return
        alto = self.alto = H - 5
        dirs, w_ant, w_act, w_vis = self.reparto()
        borde = self.at("borde")
        self.barra_titulo()
        self.pon(1, 0, "╔" + "═" * (W - 2) + "╗", borde)
        self.pon(H - 3, 0, "╚" + "═" * (W - 2) + "╝", borde)
        for y in range(2, 2 + alto):
            self.pon(y, 0, "║", borde)
            self.pon(y, W - 1, "║", borde)

        x = 1
        for k, d in enumerate(dirs):
            activa = k == len(dirs) - 1
            w = w_act if activa else w_ant
            ents, error = self.ents(d)
            if activa:
                i = self.indice(d, ents)
            else:
                i = self.cache[d].indice.get(os.path.basename(dirs[k + 1]), -1)
            top = self.ajusta_top(d, i, len(ents))
            self.cabecera(x, w, os.path.basename(d) or "/", activa)
            self.pinta_lista(x, w, ents, i, top, "activa" if activa else "camino", error)
            self.separador(x + w, len(ents), top)
            self.cols.append((x, w, "activa" if activa else "camino", d, ents, top))
            if activa:
                pie = f" {i + 1}/{len(ents)} " if ents else ""
                if self.filtro:
                    pie = f" /{self.filtro}" + (pie or " ")
                self.pon(H - 3, x + max(0, w - ancho(pie) - 1), recorta(pie, w - 1), borde)
            x += w + 1

        e, info = self.actual(), ""
        if e is not None and e.es_dir:
            self.cabecera(x, w_vis, e.visible, False)
            if e.ruta in self.cache:
                lst = self.listado(e.ruta)
                self.pinta_lista(x, w_vis, lst.entradas, -1, 0, "vista", lst.error)
                self.cols.append((x, w_vis, "vista", e.ruta, lst.entradas, 0))
                info = "" if lst.error else cuenta(len(lst.entradas))
            else:
                self.pendiente = ("dir", e.ruta)
        elif e is not None:
            self.cabecera(x, w_vis, e.visible, False)
            clave = (e.ruta, e.st.st_mtime_ns if e.st else 0, e.tam, w_vis, alto)
            v = self.vistas.get(clave)
            if v is None:
                self.pendiente = ("fichero", e, clave, w_vis - 1, alto)
            else:
                self.pinta_lineas(x + 1, 2, w_vis - 1, alto, v)
                info = v.info
        if self.pendiente:
            self.pon(3, x + 1, "…", self.at("tenue"))
        if info:
            info = recorta(f" {info} ", w_vis - 2)
            self.pon(H - 3, x + w_vis - ancho(info) - 1, info, borde)

        self.linea_estado()
        self.barra_teclas()
        if final:
            scr.refresh()
        elif final is False and self.pendiente:
            # Debajo de un diálogo no hay bucle que espere: la vista previa se calcula ya.
            self.resuelve(self.pendiente)
            self.dibuja(final=None)

    def cabecera(self, x, w, texto, activa):
        self.pon(1, x + 1, f" {recorta_nombre(texto, w - 4)} ", self.at("cab_act" if activa else "cab"))

    def separador(self, x, n, top):
        """Línea entre columnas; hace de barra de desplazamiento si la lista no cabe."""
        alto, borde = self.alto, self.at("borde")
        self.pon(1, x, "╤", borde)
        self.pon(self.H - 3, x, "╧", borde)
        d0 = d1 = -1
        if n > alto:
            largo = max(1, alto * alto // n)
            d0 = top * (alto - largo) // (n - alto)
            d1 = d0 + largo
        for f in range(alto):
            self.pon(2 + f, x, "█" if d0 <= f < d1 else "│", borde)

    def barra_titulo(self):
        W, at = self.W, self.at("barra")
        self.pon(0, 0, " " * W, at)
        marca = " CASCADA "
        self.pon(0, 0, marca, self.at("barra_res"))
        dcha = f"{self.libre()}{time.strftime('%H:%M')} "
        self.pon(0, W - ancho(dcha), dcha, at)
        hueco = W - len(marca) - ancho(dcha) - 2
        ruta = limpia(abrevia(self.cwd))
        if ancho(ruta) > hueco:
            ruta = "…" + ruta[-max(1, hueco - 1):]
        self.pon(0, len(marca) + 1, ruta, at, hueco)

    def libre(self):
        ruta, cuando, txt = self.libre_cache
        if ruta != self.cwd or time.monotonic() - cuando > 5:
            try:
                txt = f"{humano(shutil.disk_usage(self.cwd).free)} libres │ "
            except OSError:
                txt = ""
            self.libre_cache = (self.cwd, time.monotonic(), txt)
        return txt

    def linea_estado(self):
        y, W = self.H - 2, self.W
        partes = []
        if self.marcas:
            partes.append("√ " + cuenta(len(self.marcas), "marcado", "marcados"))
        if self.porta[0]:
            partes.append(f"{len(self.porta[0])} para {'mover' if self.porta[1] else 'copiar'}: p pega")
        if self.orden != "nombre":
            partes.append(f"por {self.orden}")
        if self.ocultos:
            partes.append("ocultos")
        dcha = " · ".join(partes) + " " if partes else ""
        papel = "marcado"
        if self.filtrando:
            izq = f" Filtro: {self.filtro}█"
        elif self.aviso:
            izq = " " + self.aviso
        else:
            papel, e = "estado", self.actual()
            if e is None:
                izq = ""
            elif e.st:
                izq = f" {stat.filemode(e.st.st_mode)}  {dueno(e.st.st_uid)}  {humano(e.tam)}  " \
                      f"{fecha(e.mtime)}  {e.visible}"
            else:
                izq = " " + e.visible
            if e is not None and e.es_link:
                try:
                    izq += " → " + limpia(os.readlink(e.ruta))
                except OSError:
                    pass
        self.pon(y, W - ancho(dcha), dcha, self.at("tenue"))
        self.pon(y, 0, recorta(izq, W - ancho(dcha) - 1), self.at(papel))

    def barra_teclas(self):
        y, W = self.H - 1, self.W
        paso = W // len(TECLAS_F)
        self.pon(y, 0, " " * W, self.at("ftxt"))
        for i, txt in enumerate(TECLAS_F):
            x, num = i * paso, str(i + 1)
            self.pon(y, x, num, self.at("fnum"))
            self.pon(y, x + len(num), recorta(txt, paso - len(num) - 1, ""), self.at("ftxt"))
            self.zonas_f.append((x, x + paso, curses.KEY_F0 + i + 1))

    # ── Carpetas y cursor ──

    def listado(self, d):
        lst = self.cache.get(d)
        if lst is not None:
            try:
                m = os.stat(d).st_mtime_ns
            except OSError:
                m = None
            if m == lst.mtime:
                return lst
        if len(self.cache) > 300:
            self.cache.clear()
        lst = self.cache[d] = Listado(d, self.ocultos, self.orden)
        return lst

    def ents(self, d):
        """(entradas, error) de una carpeta; en la actual, pasadas por el filtro."""
        lst = self.listado(d)
        if d == self.cwd and self.filtro:
            if self._filt[0] is not lst or self._filt[1] != self.filtro:
                f = sin_acentos(self.filtro.casefold())
                self._filt = (lst, self.filtro, [e for e in lst.entradas if f in e.clave])
            return self._filt[2], lst.error
        return lst.entradas, lst.error

    def indice(self, d, ents):
        if not ents:
            return -1
        nombre = self.sel.get(d)
        if nombre is not None:
            lst = self.cache[d]
            if ents is lst.entradas:
                i = lst.indice.get(nombre)
            else:
                i = next((k for k, e in enumerate(ents) if e.nombre == nombre), None)
            if i is not None:
                self.pos[d] = i
                return i
        i = self.pos[d] = min(self.pos.get(d, 0), len(ents) - 1)
        self.sel[d] = ents[i].nombre
        return i

    def ajusta_top(self, d, i, n):
        alto, top = self.alto, self.top.get(d, 0)
        if i >= 0:
            margen = min(2, (alto - 1) // 2)
            if i < top + margen:
                top = i - margen
            elif i >= top + alto - margen:
                top = i - alto + 1 + margen
        top = self.top[d] = max(0, min(top, n - alto))
        return top

    def actual(self):
        ents, _ = self.ents(self.cwd)
        i = self.indice(self.cwd, ents)
        return ents[i] if i >= 0 else None

    def mueve(self, delta=0, a=None):
        ents, _ = self.ents(self.cwd)
        if ents:
            i = self.indice(self.cwd, ents) + delta if a is None else a
            i = max(0, min(i, len(ents) - 1))
            self.sel[self.cwd], self.pos[self.cwd] = ents[i].nombre, i

    def cambia(self, d, sel=None):
        if d != self.cwd:
            self.anterior, self.cwd = self.cwd, d
            self.marcas.clear()
            self.filtro, self.filtrando = "", False
        if sel:
            self.sel[d] = sel

    def sube(self):
        padre = os.path.dirname(self.cwd)
        if padre != self.cwd:
            self.cambia(padre, os.path.basename(self.cwd))

    def entra(self, abrir):
        e = self.actual()
        if e is None:
            return
        if e.es_dir:
            self.cambia(e.ruta)
        elif abrir:
            try:
                subprocess.Popen(["xdg-open", e.ruta], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
                self.aviso = f"Abriendo {e.visible}…"
            except OSError as err:
                self.error("Abrir", [f"No se puede abrir: {err.strerror or err}"])

    def seleccion(self):
        """Rutas sobre las que actúan las operaciones: lo marcado o, si no, el cursor."""
        ents, _ = self.ents(self.cwd)
        if self.marcas:
            return [e.ruta for e in ents if e.nombre in self.marcas]
        e = self.actual()
        return [e.ruta] if e else []

    def tras_cambio(self, sel=None):
        self.cache.clear()
        self.vistas.clear()
        self.marcas.clear()
        if sel:
            self.sel[self.cwd] = sel

    # ── Teclado y ratón ──

    def tecla(self):
        """Una tecla: str si es un carácter, int si es especial, None si no llega ninguna."""
        try:
            t = self.scr.get_wch()
        except curses.error:
            return None
        if t in ("\r", curses.KEY_ENTER):
            return "\n"
        if t in ("\x7f", "\x08"):
            return ATRAS
        return t

    def bucle(self):
        while not self.salir:
            self.dibuja()
            pendiente = self.pendiente
            # La vista previa se calcula cuando el cursor se queda quieto, no a cada tecla.
            self.scr.timeout(40 if pendiente else 2000)
            t = self.tecla()
            if t is None:
                if pendiente:
                    self.resuelve(pendiente)
                continue
            self.aviso = ""
            self.despacha(t)
        return self.final

    def resuelve(self, p):
        if p[0] == "dir":
            self.listado(p[1])
            return
        _, e, clave, w, h = p
        self.vistas[clave] = vista_fichero(e.ruta, e.st, w, h, con_imagen=self.img_ok)
        while len(self.vistas) > 40:
            self.vistas.popitem(last=False)

    def despacha(self, t):
        K = curses
        if self.filtrando and self.tecla_filtro(t):
            return
        if t in (K.KEY_UP, "k"):
            self.mueve(-1)
        elif t in (K.KEY_DOWN, "j"):
            self.mueve(1)
        elif t == K.KEY_PPAGE:
            self.mueve(-(self.alto - 1))
        elif t == K.KEY_NPAGE:
            self.mueve(self.alto - 1)
        elif t == K.KEY_HOME:
            self.mueve(a=0)
        elif t == K.KEY_END:
            self.mueve(a=1 << 30)
        elif t in (K.KEY_LEFT, "h", ATRAS):
            self.sube()
        elif t in (K.KEY_RIGHT, "l"):
            self.entra(abrir=False)
        elif t == "\n":
            self.entra(abrir=True)
        elif t == K.KEY_MOUSE:
            self.raton()
        elif t == " ":
            e = self.actual()
            if e:
                self.marcas ^= {e.nombre}
                self.mueve(1)
        elif t == "a":
            self.marcas = {e.nombre for e in self.ents(self.cwd)[0]}
        elif t == "*":
            self.marcas = {e.nombre for e in self.ents(self.cwd)[0]} - self.marcas
        elif t == "\x1b":
            if self.filtro:
                self.filtro = ""
            elif self.marcas:
                self.marcas.clear()
            else:
                self.porta = ([], False)
        elif t == "/":
            self.filtrando = True
        elif t == ".":
            self.ocultos = not self.ocultos
            self.cache.clear()
            self.guarda_estado()
        elif t == "s":
            self.orden = ORDENES[(ORDENES.index(self.orden) + 1) % len(ORDENES)]
            self.cache.clear()
            self.guarda_estado()
            self.aviso = f"Orden: por {self.orden}"
        elif t == "T":
            nombres = list(TEMAS)
            self.pon_tema(nombres[(nombres.index(self.tema_nombre) + 1) % len(nombres)])
            self.guarda_estado()
            self.aviso = f"Tema: {self.tema_nombre}"
        elif t in ("R", "\x0c"):  # Ctrl+L, además, repinta la pantalla entera
            self.cache.clear()
            self.vistas.clear()
            self.scr.clear()
        elif t == "~":
            self.cambia(HOME)
        elif t == "-":
            self.cambia(self.anterior)
        elif t == "g":
            self.ir_a()
        elif t in (K.KEY_F9, "u"):
            self.elige_lugar()
        elif t == "b":
            self.favorito()
        elif t in (K.KEY_F1, "?"):
            self.visor("Ayuda", Vista([[(lin, "txt")] for lin in AYUDA.split("\n")]))
        elif t in (K.KEY_F2, "r"):
            self.renombra()
        elif t in (K.KEY_F3, "v"):
            self.ver()
        elif t in (K.KEY_F4, "e"):
            self.edita()
        elif t == K.KEY_F5:
            self.copia_a(mover=False)
        elif t == K.KEY_F6:
            self.copia_a(mover=True)
        elif t in ("c", "x"):
            rutas = self.seleccion()
            if rutas:
                self.porta = (rutas, t == "x")
                self.marcas.clear()
                self.aviso = f"{self.cuantos(rutas)} para {'mover' if t == 'x' else 'copiar'}: " \
                             "ve a la carpeta de destino y pulsa p"
        elif t == "p":
            self.pega()
        elif t in (K.KEY_F7, "n"):
            self.carpeta_nueva()
        elif t in (K.KEY_F8, K.KEY_DC, "d"):
            self.borrar()
        elif t == K.KEY_SDC:
            self.borrar(definitivo=True)
        elif t in ("S", "!"):
            self.shell()
        elif t in (K.KEY_F10, "q"):
            self.salir, self.final = True, self.cwd
        elif t == "Q":
            self.salir = True

    def tecla_filtro(self, t):
        """Teclas mientras se escribe el filtro. False: la tecla no era del filtro."""
        if isinstance(t, str) and t.isprintable():
            self.filtro += t
        elif t == ATRAS:
            if self.filtro:
                self.filtro = self.filtro[:-1]
            else:
                self.filtrando = False
        elif t == "\n":
            self.filtrando = False
            return True
        elif t == "\x1b":
            self.filtro, self.filtrando = "", False
            return True
        else:
            self.filtrando = t in (curses.KEY_UP, curses.KEY_DOWN, curses.KEY_PPAGE, curses.KEY_NPAGE,
                                   curses.KEY_RESIZE, curses.KEY_MOUSE)
            return False
        ents = self._filt[2] if self.ents(self.cwd)[0] is self._filt[2] else []
        if not any(e.nombre == self.sel.get(self.cwd) for e in ents):
            self.pos[self.cwd] = 0
            self.sel.pop(self.cwd, None)
        return True

    def lee_raton(self):
        """Eventos de ratón pendientes, en orden: [(x, y, clic, rueda)].

        clic: 1 sencillo, 2 doble; rueda: -1 sube, 1 baja. Si llegan varios eventos juntos, ncurses
        los entrega con una sola tecla y del último al primero: se vacía la cola y se le da la vuelta.
        """
        crudos = []
        while len(crudos) < 32:
            try:
                _, x, y, _, b = curses.getmouse()
            except curses.error:
                break
            crudos.append((x, y, b))
        eventos = []
        for x, y, b in reversed(crudos):
            if b & curses.BUTTON4_PRESSED:
                eventos.append((x, y, 0, -1))
            elif b & BOTON5:
                eventos.append((x, y, 0, 1))
            elif b & curses.BUTTON1_PRESSED:
                ahora = time.monotonic()
                doble = ahora - self.clic[0] < 0.4 and self.clic[1:] == (x, y)
                self.clic = (0 if doble else ahora, x, y)
                eventos.append((x, y, 2 if doble else 1, 0))
        return eventos

    def raton(self):
        for x, y, clic, rueda in self.lee_raton():
            if rueda:
                self.mueve(3 * rueda)
            elif y == self.H - 1:
                for x0, x1, tecla in self.zonas_f:
                    if x0 <= x < x1:
                        return self.despacha(tecla)
            elif 2 <= y < 2 + self.alto:
                self.clic_en_columna(x, y, clic)
                self.dibuja(final=False)  # por si el siguiente evento cae ya en otra disposición

    def clic_en_columna(self, x, y, clic):
        for x0, w, modo, d, ents, top in self.cols:
            if not x0 <= x < x0 + w:
                continue
            i = top + y - 2
            if i >= len(ents):
                if modo != "activa":
                    self.cambia(d)
            elif modo == "activa":
                ya = self.sel.get(d) == ents[i].nombre
                self.sel[d] = ents[i].nombre
                if clic == 2 and ya:
                    self.entra(abrir=True)
            else:
                self.cambia(d, ents[i].nombre)
            return

    # ── Diálogos ──

    def caja(self, titulo, w, h, papel="dlg"):
        """Caja centrada con sombra. Devuelve (y, x, w, h) ya ajustados a la pantalla."""
        w, h = max(10, min(w, self.W - 4)), max(3, min(h, self.H - 2))
        y, x = max(0, (self.H - h) // 2 - 1), (self.W - w) // 2
        at = self.at(papel)
        for i in range(1, h + 1):
            self.pon(y + i, x + 2, " " * w, self.at("sombra"))
        self.pon(y, x, "╔" + "═" * (w - 2) + "╗", at)
        for i in range(1, h - 1):
            self.pon(y + i, x, "║" + " " * (w - 2) + "║", at)
        self.pon(y + h - 1, x, "╚" + "═" * (w - 2) + "╝", at)
        titulo = recorta(f" {titulo} ", w - 4)
        self.pon(y, x + (w - ancho(titulo)) // 2, titulo, at)
        return y, x, w, h

    def confirmar(self, titulo, lineas, botones=("Sí", "No"), defecto=0, papel="dlg"):
        """Diálogo con botones. Devuelve el índice del pulsado, o -1 con Esc."""
        sel, n = defecto, len(botones)
        while True:
            self.fondo(final=False)
            bw = sum(ancho(b) + 4 for b in botones) + 2 * (n - 1)
            w = min(self.W - 4, max(bw + 6, max(map(ancho, lineas), default=0) + 6, ancho(titulo) + 8, 34))
            visibles = lineas[:max(1, self.H - 8)]
            y, x, w, h = self.caja(titulo, w, len(visibles) + 5, papel)
            for i, lin in enumerate(visibles):
                self.pon(y + 2 + i, x + 3, recorta(lin, w - 6), self.at(papel))
            bx, zonas = x + (w - bw) // 2, []
            for i, b in enumerate(botones):
                txt = f"[ {b} ]"
                self.pon(y + h - 2, bx, txt, self.at("dlg_btn_sel" if i == sel else papel))
                zonas.append((bx, bx + ancho(txt), i))
                bx += ancho(txt) + 2
            self.scr.refresh()
            self.scr.timeout(-1)
            t = self.tecla()
            if t in (curses.KEY_LEFT, curses.KEY_BTAB, curses.KEY_UP):
                sel = (sel - 1) % n
            elif t in (curses.KEY_RIGHT, "\t", curses.KEY_DOWN):
                sel = (sel + 1) % n
            elif t == "\n":
                return sel
            elif t == "\x1b":
                return -1
            elif t == curses.KEY_MOUSE:
                for mx, my, clic, _ in self.lee_raton():
                    for x0, x1, i in zonas:
                        if clic and my == y + h - 2 and x0 <= mx < x1:
                            return i
            elif isinstance(t, str):
                iguales = [i for i, b in enumerate(botones) if sin_acentos(b[0].casefold()) == t.casefold()]
                if len(iguales) == 1:
                    return iguales[0]

    def error(self, titulo, lineas):
        self.confirmar(titulo, lineas, ("Aceptar",), papel="dlg_err")

    def completa(self, texto):
        """Tab en un campo de ruta: (texto completado, candidatos)."""
        base = os.path.expanduser(texto)
        if not os.path.isabs(base):
            base = os.path.join(self.cwd, base)
        carpeta, prefijo = os.path.split(base)
        if not texto.endswith(prefijo):
            return texto, []
        try:
            nombres = sorted(n for n in os.listdir(carpeta)
                             if n.startswith(prefijo) and (prefijo.startswith(".") or not n.startswith(".")))
        except OSError:
            return texto, []
        if not nombres:
            return texto, []
        comun = os.path.commonprefix(nombres)
        nuevo = texto[:len(texto) - len(prefijo)] + comun
        if len(nombres) == 1 and os.path.isdir(os.path.join(carpeta, comun)):
            nuevo += "/"
        return nuevo, nombres

    def pedir(self, titulo, etiqueta, inicial="", cursor=None, rutas=False):
        """Pide una línea de texto. Devuelve None si se cancela."""
        buf, pos, pista = inicial, len(inicial) if cursor is None else cursor, ""
        try:
            curses.curs_set(1)
        except curses.error:
            pass
        try:
            while True:
                self.fondo(final=False)
                y, x, w, _ = self.caja(titulo, max(56, ancho(etiqueta) + 6), 7)
                cw = w - 4
                self.pon(y + 1, x + 2, recorta(etiqueta, cw), self.at("dlg"))
                desde = max(0, pos - cw + 1)
                self.pon(y + 3, x + 2, ajusta(recorta(buf[desde:], cw, ""), cw), self.at("dlg_campo"))
                ayuda = "Intro acepta · Esc cancela" + (" · Tab completa" if rutas else "")
                self.pon(y + 5, x + 2, recorta(pista or ayuda, cw), self.at("dlg_tenue"))
                try:
                    self.scr.move(y + 3, x + 2 + min(cw - 1, ancho(buf[desde:pos])))
                except curses.error:
                    pass
                self.scr.refresh()
                self.scr.timeout(-1)
                t = self.tecla()
                pista = ""
                if t == "\n":
                    return buf
                if t == "\x1b":
                    return None
                if t == curses.KEY_LEFT:
                    pos = max(0, pos - 1)
                elif t == curses.KEY_RIGHT:
                    pos = min(len(buf), pos + 1)
                elif t in (curses.KEY_HOME, "\x01"):
                    pos = 0
                elif t in (curses.KEY_END, "\x05"):
                    pos = len(buf)
                elif t == ATRAS:
                    if pos:
                        buf, pos = buf[:pos - 1] + buf[pos:], pos - 1
                elif t == curses.KEY_DC:
                    buf = buf[:pos] + buf[pos + 1:]
                elif t == "\x15":  # Ctrl+U
                    buf, pos = buf[pos:], 0
                elif t == "\x0b":  # Ctrl+K
                    buf = buf[:pos]
                elif t == "\t" and rutas:
                    buf, candidatos = self.completa(buf[:pos] + buf[pos:])
                    pos = len(buf)
                    if len(candidatos) > 1:
                        pista = "  ".join(limpia(c) for c in candidatos[:30])
                    elif not candidatos:
                        pista = "(nada que empiece así)"
                elif t == curses.KEY_MOUSE:
                    self.lee_raton()
                elif isinstance(t, str) and t.isprintable():
                    buf, pos = buf[:pos] + t + buf[pos:], pos + 1
        finally:
            try:
                curses.curs_set(0)
            except curses.error:
                pass

    def menu(self, titulo, items, sel=0):
        """Lista para elegir. Devuelve el índice, o -1 con Esc."""
        top = 0
        while True:
            self.fondo(final=False)
            alto = max(1, min(len(items), self.H - 6))
            w = max(max(map(ancho, items)) + 6, ancho(titulo) + 8, 30)
            y, x, w, _ = self.caja(titulo, w, alto + 2)
            top = max(0, min(max(top, sel - alto + 1), sel, len(items) - alto))
            for f in range(alto):
                i = top + f
                self.pon(y + 1 + f, x + 1, ajusta(" " + recorta(items[i], w - 4), w - 2),
                         self.at("dlg_btn_sel" if i == sel else "dlg"))
            self.scr.refresh()
            self.scr.timeout(-1)
            t = self.tecla()
            if t in (curses.KEY_UP, "k"):
                sel = max(0, sel - 1)
            elif t in (curses.KEY_DOWN, "j"):
                sel = min(len(items) - 1, sel + 1)
            elif t == curses.KEY_PPAGE:
                sel = max(0, sel - alto)
            elif t == curses.KEY_NPAGE:
                sel = min(len(items) - 1, sel + alto)
            elif t == curses.KEY_HOME:
                sel = 0
            elif t == curses.KEY_END:
                sel = len(items) - 1
            elif t in ("\n", curses.KEY_RIGHT):
                return sel
            elif t in ("\x1b", "q", curses.KEY_LEFT, curses.KEY_F9, curses.KEY_F10):
                return -1
            elif t == curses.KEY_MOUSE:
                for mx, my, clic, rueda in self.lee_raton():
                    if rueda:
                        sel = max(0, min(len(items) - 1, sel + rueda))
                    elif x < mx < x + w - 1 and 0 <= my - y - 1 < alto:
                        return top + my - y - 1
                    else:
                        return -1  # clic fuera de la lista: cerrar

    def progreso(self, tarea, titulo):
        hilo = threading.Thread(target=tarea.run, daemon=True)
        hilo.start()
        hilo.join(0.2)  # lo inmediato no llega a enseñar el diálogo
        self.scr.timeout(100)
        while not tarea.fin:
            self.fondo(final=False)
            y, x, w, _ = self.caja(titulo, 64, 8)
            dlg, cw = self.at("dlg"), w - 6
            self.pon(y + 2, x + 3, recorta_nombre(limpia(tarea.actual), cw), dlg)
            if tarea.total:
                hecho = min(tarea.hecho, tarea.total)
                n = hecho * cw // tarea.total
                self.pon(y + 3, x + 3, "█" * n + "░" * (cw - n), dlg)
                self.pon(y + 4, x + 3, f"{humano(hecho)} de {humano(tarea.total)}", dlg)
            else:
                self.pon(y + 3, x + 3, "Calculando…", dlg)
            self.pon(y + 6, x + 3, "Cancelando…" if tarea.cancelar else "Esc cancela", self.at("dlg_tenue"))
            self.scr.refresh()
            try:
                t = self.tecla()
            except KeyboardInterrupt:  # Ctrl+C a media copia: cancelar limpiamente, no morir
                t = "\x1b"
            if t == "\x1b":
                tarea.cancelar = True
            elif t == curses.KEY_MOUSE:
                self.lee_raton()
        hilo.join()

    # ── Visor ──

    def visor(self, titulo, vista):
        lineas, top, dx, busca, marca, textos = vista.lineas, 0, 0, "", -1, None

        def pinta(final=True):
            nonlocal top
            self.H, self.W = H, W = self.scr.getmaxyx()
            alto = max(1, H - 2)
            top = max(0, min(top, len(lineas) - alto))
            self.scr.erase()
            self.pon(0, 0, " " * W, self.at("barra"))
            dcha = f"{top + 1}-{min(len(lineas), top + alto)} de {len(lineas)} "
            self.pon(0, W - len(dcha), dcha, self.at("barra"))
            self.pon(0, 0, recorta(f" {titulo}" + (f" · {vista.info}" if vista.info else ""), W - len(dcha) - 1),
                     self.at("barra"))
            self.pinta_lineas(0, 1, W, alto, vista, top, dx, marca)
            pie = " ↑↓ RePág AvPág Inicio Fin  ←→ desplazar  / buscar  n siguiente  q volver"
            self.pon(H - 1, 0, ajusta(recorta(pie, W), W), self.at("ftxt"))
            if final:
                self.scr.refresh()
            return alto

        self.fondo = pinta
        try:
            while True:
                alto = pinta()
                self.scr.timeout(-1)
                t = self.tecla()
                K = curses
                if t in ("q", "\x1b", "\n", "v", K.KEY_F3, K.KEY_F10, K.KEY_F1, ATRAS):
                    return
                if t in (K.KEY_UP, "k"):
                    top -= 1
                elif t in (K.KEY_DOWN, "j"):
                    top += 1
                elif t == K.KEY_PPAGE:
                    top -= alto - 1
                elif t in (K.KEY_NPAGE, " "):
                    top += alto - 1
                elif t == K.KEY_HOME:
                    top = 0
                elif t == K.KEY_END:
                    top = len(lineas)
                elif t == K.KEY_LEFT:
                    dx = max(0, dx - 8)
                elif t == K.KEY_RIGHT:
                    dx += 8
                elif t == K.KEY_MOUSE:
                    top += 3 * sum(rueda for *_, rueda in self.lee_raton())
                elif t in ("/", "n"):
                    if t == "/" or not busca:
                        busca = self.pedir("Buscar", "Texto a buscar:", busca) or busca
                        if not busca:
                            continue
                    if textos is None:
                        textos = [sin_acentos("".join(s for s, _ in lin).casefold()) for lin in lineas]
                    aguja = sin_acentos(busca.casefold())
                    desde = marca + 1 if marca >= top else top
                    marca = next((i for i in [*range(desde, len(textos)), *range(desde)] if aguja in textos[i]), -1)
                    if marca >= 0:
                        top = marca - min(3, alto // 2)
        finally:
            self.fondo = self.dibuja

    # ── Acciones ──

    def ver(self):
        e = self.actual()
        if e is None or e.es_dir:
            return
        self.aviso = "Leyendo…"
        self.dibuja()
        self.aviso = ""
        self.visor(e.visible, vista_fichero(e.ruta, e.st, self.W, self.H - 2, completa=True,
                                            con_imagen=self.img_ok))

    def externo(self, args, cwd=None, entorno=None, saludo=None):
        """Suelta la pantalla, lanza un programa y la recupera al volver."""
        curses.endwin()
        error = None
        try:
            if saludo:
                print(saludo, flush=True)
            subprocess.call(args, cwd=cwd, env=entorno)
        except OSError as e:
            error = e.strerror or str(e)
        except KeyboardInterrupt:
            pass
        self.scr.clear()
        self.scr.refresh()
        self.tras_cambio()
        if error:
            self.error("No se puede lanzar", [f"{args[0]}: {error}"])

    def edita(self):
        e = self.actual()
        if e is None or e.es_dir:
            return
        editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or \
            next((p for p in ("nano", "vim", "vi") if shutil.which(p)), None)
        if not editor:
            self.error("Editar", ["No hay editor: define la variable EDITOR."])
            return
        self.externo(shlex.split(editor) + [e.ruta], cwd=self.cwd)
        self.sel[self.cwd] = e.nombre

    def shell(self):
        shell = os.environ.get("SHELL") or "/bin/bash"
        self.externo([shell], cwd=self.cwd, entorno={**os.environ, "CASCADA": "1"},
                     saludo=f"cascada: shell en {abrevia(self.cwd)} · «exit» o Ctrl+D para volver")

    def ir_a(self):
        txt = self.pedir("Ir a", "Carpeta:", abrevia(self.cwd).rstrip("/") + "/", rutas=True)
        if not txt:
            return
        ruta = os.path.normpath(os.path.join(self.cwd, os.path.expanduser(txt)))
        if os.path.isdir(ruta):
            self.cambia(ruta)
        elif os.path.lexists(ruta):
            self.cambia(os.path.dirname(ruta), os.path.basename(ruta))
        else:
            self.error("Ir a", [f"No existe {limpia(txt)}"])

    def elige_lugar(self):
        lista = sitios(self.favoritos)
        w = max(ancho(et) for et, _, _ in lista)
        i = self.menu("Sitios", [f"{ajusta(et, w)}  {limpia(abrevia(r))}" + (f"  ·  {det}" if det else "")
                                 for et, r, det in lista])
        if i >= 0:
            self.cambia(lista[i][1])

    def favorito(self):
        """Pone o quita la carpeta actual de los favoritos del menú de sitios."""
        if self.cwd in self.favoritos:
            self.favoritos.remove(self.cwd)
            self.aviso = f"{limpia(abrevia(self.cwd))} ya no está en favoritos"
        else:
            self.favoritos.append(self.cwd)
            self.aviso = f"{limpia(abrevia(self.cwd))} añadida a favoritos: F9 (o u) para ir"
        self.guarda_estado()

    def renombra(self):
        e = self.actual()
        if e is None:
            return
        raiz = e.nombre if e.es_dir else os.path.splitext(e.nombre)[0]
        nuevo = self.pedir("Renombrar", f"Nombre nuevo para {recorta_nombre(e.visible, 40)}:", e.nombre,
                           cursor=len(raiz) or len(e.nombre))
        if not nuevo or nuevo == e.nombre:
            return
        destino = os.path.join(self.cwd, nuevo)
        if "/" in nuevo or nuevo in (".", ".."):
            self.error("Renombrar", ["El nombre no puede llevar «/»."])
        elif os.path.lexists(destino):
            self.error("Renombrar", [f"Ya existe {limpia(nuevo)}."])
        else:
            try:
                os.rename(e.ruta, destino)
            except OSError as err:
                self.error("Renombrar", [err.strerror or str(err)])
            self.tras_cambio(nuevo)

    def carpeta_nueva(self):
        nombre = self.pedir("Carpeta nueva", "Nombre de la carpeta:")
        if not nombre:
            return
        try:
            os.makedirs(os.path.join(self.cwd, nombre))
        except OSError as err:
            self.error("Carpeta nueva", [err.strerror or str(err)])
        self.tras_cambio(nombre.strip("/").split("/")[0])

    @staticmethod
    def cuantos(rutas):
        return limpia(os.path.basename(rutas[0])) if len(rutas) == 1 else cuenta(len(rutas))

    @staticmethod
    def enumera(rutas, tope=6):
        lineas = ["  " + recorta_nombre(limpia(os.path.basename(r)), 56) for r in rutas[:tope]]
        if len(rutas) > tope:
            lineas.append(f"  … y {len(rutas) - tope} más")
        return lineas

    def borrar(self, definitivo=False):
        rutas = self.seleccion()
        if not rutas:
            return
        if any(os.path.normpath(r) in ("/", HOME) for r in rutas):
            self.error("Borrar", ["Eso no se borra desde aquí."])
            return
        if definitivo:
            pregunta = ["¿Borrar DEFINITIVAMENTE? No se puede deshacer.", ""] + self.enumera(rutas)
        else:
            if self.confirmar("Borrar", ["¿Enviar a la papelera?", ""] + self.enumera(rutas),
                              ("Papelera", "Cancelar")) != 0:
                return
            self.aviso = "Enviando a la papelera…"
            self.dibuja()
            fallo = a_la_papelera(rutas)
            quedan = [r for r in rutas if os.path.lexists(r)]
            self.tras_cambio()
            self.aviso = f"{self.cuantos(rutas)}: a la papelera" if not quedan else ""
            if not quedan:
                return
            rutas = quedan
            pregunta = ["No se ha podido enviar a la papelera:", "  " + recorta(fallo, 60), ""] \
                + self.enumera(rutas) + ["", "¿Borrar definitivamente? No se puede deshacer."]
        if self.confirmar("Borrar definitivamente", pregunta, ("Borrar", "Cancelar"), 1, "dlg_err") != 0:
            return
        errores = []
        for r in rutas:
            try:
                borra(r)
            except OSError as e:
                errores.append(f"{limpia(os.path.basename(r))}: {e.strerror or e}")
        self.tras_cambio()
        if errores:
            self.error("Borrar", errores[:8])
        else:
            self.aviso = f"{self.cuantos(rutas)}: borrado"

    def copia_a(self, mover):
        rutas = self.seleccion()
        if not rutas:
            return
        verbo = "Mover" if mover else "Copiar"
        txt = self.pedir(verbo, f"{verbo} {self.cuantos(rutas)} a:", abrevia(self.cwd).rstrip("/") + "/",
                         rutas=True)
        if not txt:
            return
        destino = os.path.normpath(os.path.join(self.cwd, os.path.expanduser(txt)))
        if os.path.isdir(destino) or txt.endswith("/") or len(rutas) > 1:
            if not os.path.isdir(destino):
                if self.confirmar(verbo, [f"No existe la carpeta {limpia(abrevia(destino))}.", "¿Crearla?"]) != 0:
                    return
                try:
                    os.makedirs(destino)
                except OSError as err:
                    self.error(verbo, [err.strerror or str(err)])
                    return
            pares = [(r, os.path.join(destino, os.path.basename(r))) for r in rutas]
        else:
            pares = [(rutas[0], destino)]  # un solo origen y un nombre nuevo: copiar renombrando
        self.transfiere(pares, mover)

    def pega(self):
        rutas, mover = self.porta
        rutas = [r for r in rutas if os.path.lexists(r)]
        if not rutas:
            self.aviso = "No hay nada que pegar: copia con c o corta con x"
            return
        self.transfiere([(r, os.path.join(self.cwd, os.path.basename(r))) for r in rutas], mover)
        if mover:
            self.porta = ([], False)

    def transfiere(self, pares, mover):
        """Copia o mueve pares (origen, destino), preguntando antes qué hacer con lo que ya exista."""
        verbo, plan, chocan, avisos = ("Mover" if mover else "Copiar"), [], [], []
        for origen, destino in pares:
            real_o = os.path.realpath(origen)
            real_d = os.path.join(os.path.realpath(os.path.dirname(destino)), os.path.basename(destino))
            if real_d == real_o:
                if not mover:
                    plan.append((origen, nombre_libre(destino), False))  # pegar en su sitio: duplicar
            elif real_d.startswith(real_o.rstrip("/") + "/"):
                avisos.append(f"{limpia(os.path.basename(origen))}: no cabe dentro de sí misma")
            elif os.path.lexists(destino):
                chocan.append((origen, destino))
            else:
                plan.append((origen, destino, False))
        if chocan:
            # Solo se pisa fichero sobre fichero; mezclar carpetas a ciegas es pedir un disgusto.
            pisables = all(not os.path.isdir(o) and not os.path.isdir(d) for o, d in chocan)
            botones = ("Conservar ambos",) + (("Sobrescribir",) if pisables else ()) + ("Saltar", "Cancelar")
            r = self.confirmar(verbo, ["Ya existen en el destino:", ""] + self.enumera([d for _, d in chocan]),
                               botones)
            if r < 0 or botones[r] == "Cancelar":
                return
            if botones[r] == "Conservar ambos":
                plan += [(o, nombre_libre(d), False) for o, d in chocan]
            elif botones[r] == "Sobrescribir":
                plan += [(o, d, True) for o, d in chocan]
        tarea = Tarea(plan, mover)
        if plan:
            self.progreso(tarea, "Moviendo" if mover else "Copiando")
        self.tras_cambio()
        hechos = [d for d in tarea.hechos if os.path.dirname(d) == self.cwd]
        if hechos:
            self.sel[self.cwd] = os.path.basename(hechos[0])
        errores = avisos + tarea.errores
        if errores:
            self.error(verbo, errores[:8] + ([f"… y {len(errores) - 8} errores más"] if len(errores) > 8 else []))
        elif tarea.cancelar:
            self.aviso = "Cancelado"
        elif tarea.hechos:
            self.aviso = f"{self.cuantos(tarea.hechos)}: {'movido' if mover else 'copiado'}"


def main():
    ap = argparse.ArgumentParser(prog="cascada", description=__doc__, add_help=False,
                                 formatter_class=argparse.RawDescriptionHelpFormatter, usage=argparse.SUPPRESS)
    ap.add_argument("-h", "--help", action="help", help=argparse.SUPPRESS)
    ap.add_argument("ruta", nargs="?", default=".", help=argparse.SUPPRESS)
    ap.add_argument("--elegir-dir", metavar="FICHERO", help=argparse.SUPPRESS)
    ap.add_argument("--shell", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--tema", choices=list(TEMAS), help=argparse.SUPPRESS)
    ap.add_argument("--version", action="version", version=f"cascada {VERSION}", help=argparse.SUPPRESS)
    args = ap.parse_args()
    if args.shell:
        print(FUNCION_SHELL)
        return 0

    ruta, sel = os.path.abspath(os.path.expanduser(args.ruta)), None
    pwd_logico = os.environ.get("PWD")
    if args.ruta == "." and pwd_logico:
        try:
            if os.path.samefile(pwd_logico, "."):
                ruta = os.path.normpath(pwd_logico)  # respeta el camino por el que se llegó (enlaces)
        except OSError:
            pass
    if not os.path.isdir(ruta):
        if not os.path.lexists(ruta):
            sys.exit(f"cascada: no existe {args.ruta}")
        ruta, sel = os.path.split(ruta)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        sys.exit("cascada: hace falta una terminal")

    locale.setlocale(locale.LC_ALL, "")
    warnings.simplefilter("ignore")  # un aviso de Pillow por stderr destrozaría la pantalla
    try:
        final = curses.wrapper(lambda scr: App(scr, ruta, sel, args.tema).bucle())
    except KeyboardInterrupt:
        return 130
    if args.elegir_dir and final:
        try:
            Path(args.elegir_dir).write_text(final)
        except OSError as e:
            print(f"cascada: {e}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
