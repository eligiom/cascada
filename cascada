    for papel in ("oculto", "tenue", "com", "hex_off", "cab", "borde", "sombra", "roto"):
        t[papel] = (oscuro, fondo)
    for papel in ("cursor", "barra", "ftxt", "dlg", "dlg_tenue"):
        t[papel] = (fondo, medio)
    t.update(barra_res=(claro, fondo, _N), cursor_marc=(fondo, claro, _N), camino=(fondo, oscuro),
             fnum=(claro, fondo), dlg_btn_sel=(claro, fondo, _N), dlg_campo=(claro, fondo),
             dlg_err=(fondo, claro, _N), txt=(medio, fondo))
